{
  "name": "@revamp/core",
  "version": "1.0.0",
  "description": "Frontend business logic — types, query keys, API client interface (zero react-dom, zero next/*)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types/*": "./src/types/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./api/*": "./src/api/*.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
