{
  "name": "@revamp/ui",
  "version": "1.0.0",
  "description": "Shared UI components for REVAMP applications",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./utils": "./src/utils.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3",
    "lucide-react": ">=0.300.0"
  },
  "dependencies": {
    "@revamp/shared-types": "workspace:*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0",
    "@radix-ui/react-dialog": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "lucide-react": "^1.7.0",
    "typescript": "^5.5.0"
  }
}
