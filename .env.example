# REVAMP Platform - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# === Application Environment ===
NODE_ENV=development
DEBUG=false

# === Database Configuration ===
# Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql://revamp:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/revamp
DB_USER=revamp
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=revamp
DB_POOL_SIZE=20
DB_POOL_IDLE_TIMEOUT=30000

# === Redis Configuration ===
# Generate a strong password: openssl rand -base64 32
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@localhost:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_TLS=false

# === MinIO Configuration ===
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=REPLACE_WITH_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_USER
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_PASSWORD
MINIO_BUCKET=revamp
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# === API Configuration ===
API_PORT=3000
API_HOST=0.0.0.0
API_LOG_LEVEL=debug
API_CORS_ORIGIN=http://localhost:3001

# === Web Application Configuration ===
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# === LLM Provider Configuration ===
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
OPENAI_ORG_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_REGION=us-east-1

# === LLM Orchestrator Configuration ===
LLM_ORCHESTRATOR_PORT=8080
LLM_ORCHESTRATOR_LOG_LEVEL=info
LLM_CACHE_TTL=3600
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# === Authentication & Security ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800
SESSION_SECRET=change_me_with_a_strong_random_string
ENCRYPTION_KEY=change_me_with_a_32_byte_hex_string

# === Email Configuration ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@revamp.example.com
SMTP_TLS=true

# === Observability ===
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# === Monitoring & Metrics ===
PROMETHEUS_PORT=9090
ENABLE_METRICS=true
METRICS_RETENTION_DAYS=30

# === Feature Flags ===
FEATURE_PARALLEL_RUN=true
FEATURE_ADVANCED_VALIDATION=true
FEATURE_COST_ESTIMATION=true
FEATURE_CUSTOM_PROMPTS=true

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT=1000

# === File Upload ===
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=.ts,.js,.py,.java,.go,.rs,.cpp,.c,.h,.txt,.json,.yaml,.yml

# === Platform Configuration ===
SUPPORTED_CLOUD_PROVIDERS=aws,gcp,azure
PLATFORM_NAME=REVAMP
PLATFORM_VERSION=1.0.0
ORGANIZATION_NAME=Your Organization

# === External Services ===
GITHUB_API_TOKEN=
GITLAB_API_TOKEN=
JIRA_API_TOKEN=
SLACK_WEBHOOK_URL=

# === Development Tools ===
ENABLE_MOCK_DATA=false
MOCK_LLM_RESPONSES=false
ENABLE_DEBUG_ROUTES=false

# === Kubernetes Configuration (if applicable) ===
KUBE_NAMESPACE=revamp
KUBE_API_URL=
KUBE_AUTH_TOKEN=

# === SSL/TLS Configuration ===
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=

# === Advanced Configuration ===
# Connection pool sizing
DB_MAX_CONNECTIONS=50
DB_IDLE_TIMEOUT=10000

# Cache configuration
CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=1000

# Queue configuration
QUEUE_CONCURRENCY=10
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000

# Performance
REQUEST_TIMEOUT=30000
SHUTDOWN_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=65000
