# Multi-stage build for the Fastify API (pnpm monorepo).
#
# Layout:
#   /app                       — monorepo root (package.json, pnpm-workspace.yaml, turbo.json)
#   /app/apps/api              — this service's source
#   /app/packages/*            — workspace dependencies (shared-types, core-engine, core, ...)
#
# Build runs turbo with --filter=@revamp/api... so it compiles API + all deps
# in the right order, caching on turbo remote if configured.

# ─── deps: install pnpm + all workspace deps ────────────────────────────────
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat python3 make g++ git
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy root manifests + workspace manifests first (better cache hits)
COPY package.json pnpm-workspace.yaml turbo.json ./
COPY pnpm-lock.yaml* ./
COPY apps/api/package.json            apps/api/
COPY apps/web/package.json            apps/web/
COPY apps/vscode/package.json         apps/vscode/
COPY packages/core/package.json       packages/core/
COPY packages/core-engine/package.json packages/core-engine/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/ui/package.json         packages/ui/
COPY packages/views/package.json      packages/views/
# NOTE: packages/config/ is a folder of shared eslint/tailwind/tsconfig
# fragments (no package.json of its own), consumed via relative paths — not
# a workspace package, so nothing to install from it.

# No-frozen because the committed repo may not include pnpm-lock.yaml
# (it's in .gitignore). If you later commit the lockfile, swap to --frozen-lockfile.
RUN pnpm install --no-frozen-lockfile

# ─── builder: build the API + its workspace deps ───────────────────────────
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app
COPY --from=deps /app ./

# Copy full source tree
COPY . .

ENV NODE_ENV=production
# Turbo needs to find pnpm in PATH — already on via corepack above.
RUN pnpm turbo build --filter=@revamp/api...

# Drizzle SQL migrations are gitignored in this repo, but the journal at
# apps/api/drizzle/meta/_journal.json IS committed and references .sql files
# we don't have. Wipe the drizzle folder entirely and regenerate from
# schema.ts to get a single consolidated migration representing the full
# current schema. This is safe for fresh DBs (our deploy target) because
# drizzle-orm tracks applied migrations in its own __drizzle_migrations
# ledger and is idempotent on re-run.
RUN cd apps/api && \
    rm -rf drizzle && \
    mkdir -p drizzle/meta && \
    echo '{"version":"7","dialect":"postgresql","entries":[]}' > drizzle/meta/_journal.json && \
    pnpm drizzle-kit generate && \
    echo "=== generated migrations ===" && ls -la drizzle/

# ─── runner: minimal production image ───────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@9 --activate

# Unprivileged user
RUN addgroup -g 1001 -S nodejs && adduser -S fastify -u 1001

# Copy source + all workspace deps. We run via tsx at runtime instead of
# compiled dist/ because:
#   - The monorepo's tsconfig uses @/ path aliases that tsc alone doesn't
#     rewrite; tsx resolves them transparently (same as `pnpm dev`).
#   - packages/core-engine's compiled output has some extension-less imports
#     that break under strict Node ESM; tsx handles extension resolution.
# Once tsc + tsc-alias + extension-fixups are fully wired for production
# builds, swap back to `node dist/server.js`.
COPY --from=builder --chown=fastify:nodejs /app/node_modules            ./node_modules
COPY --from=builder --chown=fastify:nodejs /app/package.json            ./package.json
COPY --from=builder --chown=fastify:nodejs /app/pnpm-workspace.yaml     ./pnpm-workspace.yaml
COPY --from=builder --chown=fastify:nodejs /app/apps/api/package.json   ./apps/api/package.json
COPY --from=builder --chown=fastify:nodejs /app/apps/api/tsconfig.json  ./apps/api/tsconfig.json
COPY --from=builder --chown=fastify:nodejs /app/apps/api/src            ./apps/api/src
COPY --from=builder --chown=fastify:nodejs /app/apps/api/drizzle        ./apps/api/drizzle
COPY --from=builder --chown=fastify:nodejs /app/apps/api/node_modules   ./apps/api/node_modules
COPY --from=builder --chown=fastify:nodejs /app/packages                ./packages

USER fastify
WORKDIR /app/apps/api

EXPOSE 8787
ENV PORT=8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
  CMD node -e "require('http').get('http://127.0.0.1:' + (process.env.PORT||8787) + '/health', (r) => { if (r.statusCode !== 200) throw new Error(r.statusCode) })"

# Apply any pending Drizzle migrations, then launch the server via tsx
# (resolves @/ path aliases + extension-less imports). Idempotent:
# drizzle-orm records applied migrations in its own __drizzle_migrations table.
CMD ["sh", "-c", "npx -y tsx src/db/migrate.ts && exec npx -y tsx src/server.ts"]
