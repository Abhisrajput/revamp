# REVAMP Customer Deployment — edit these before `docker compose up`
# Generate random secrets with: openssl rand -hex 32

REVAMP_VERSION=latest

# ─── Application Database ─────────────────────────────────────────────────────
# Used by Postgres, the API, and the Agent Worker.
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_random_password

# ─── Auth (API) ───────────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ─── Keycloak ─────────────────────────────────────────────────────────────────
# Realm admin credentials for the Keycloak admin UI.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_strong_random_password
# Keycloak's own internal Postgres password (separate from the app DB).
KEYCLOAK_DB_PASSWORD=CHANGE_ME_strong_random_password
# Hostname Keycloak advertises in tokens — must match what the browser reaches.
# Example: auth.mycompany.com or the server's public IP.
KEYCLOAK_HOSTNAME=localhost

# ─── Object Storage (MinIO) ───────────────────────────────────────────────────
# Swap these for your real S3 credentials and set MINIO_ENDPOINT in the
# api service environment if using an external S3 bucket instead.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_random_password

# ─── Public URLs (used by the Next.js frontend) ───────────────────────────────
# These must be the URLs a browser will reach — usually the host's public name.
PUBLIC_API_URL=http://localhost/api
PUBLIC_WS_URL=ws://localhost/api
PUBLIC_KEYCLOAK_URL=http://localhost/auth

# ─── Networking ───────────────────────────────────────────────────────────────
HTTP_PORT=80
# HTTPS_PORT=443

# ─── Optional LLM Credentials — set at least one ─────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
