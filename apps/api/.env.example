# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revamp

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Redis
REDIS_URL=redis://localhost:6379

# Go LLM Orchestrator
GO_LLM_ORCHESTRATOR_URL=http://localhost:8000
GO_LLM_ORCHESTRATOR_API_KEY=orchestrator-api-key

# Storage
STORAGE_TYPE=s3
S3_BUCKET=revamp-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=900000

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Email (for password reset, etc)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-api-key

# Logging
LOG_LEVEL=info

# Diagnostic Agent (SDK-experimental) — direct Anthropic API key for diagnostic agent only.
# Separate from BYOK pipeline credentials. Optional — diagnostic feature is disabled if unset.
ANTHROPIC_API_KEY=

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_AUDIT_LOGS=true
